{
  "name": "companyisland",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && tauri",
    "test": "vitest run",
    "prebuild:installer": "node scripts/check-versions.cjs",
    "build:center": "node scripts/build-center.cjs",
    "build:installer": "npm run tauri -- build --config src-tauri/tauri.installer.conf.json",
    "postbuild:installer": "node scripts/build-center.cjs --check-installer-script",
    "check:installer": "node scripts/build-center.cjs --check-installer-script",
    "posttauri": "node scripts/build-center.cjs --after-tauri"
  },
  "dependencies": {
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
