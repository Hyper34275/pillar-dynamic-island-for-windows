<Page
    x:Class="CompanyIsland.Center.Pages.SmartSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:CompanyIsland.Center.Core"
    Background="Transparent">

    <Page.Resources>
        <!-- Every brush is a ThemeResource so high contrast keeps working; the code-behind only picks styles. -->
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The user's question: on the start side, a light card. -->
        <Style x:Key="UserBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CenterStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="AnswerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ResultCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="AccentBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource CenterStrongBorderBrush}" />
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
        </Style>
        <Style x:Key="UnreadDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Layout" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,24,24,8" Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind s:Strings.SearchTitle}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="{x:Bind s:Strings.SearchSubtitle}"
                    Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <InfoBar
                x:Name="OffBar"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False"
                Title="{x:Bind s:Strings.SearchOffTitle}"
                Message="{x:Bind s:Strings.SearchOffMessage}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="Conversation" Padding="24,8,24,16" Spacing="14" MaxWidth="900" />
            </ScrollViewer>

            <!-- Empty state: example questions to click. -->
            <StackPanel
                x:Name="EmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="10"
                Padding="24"
                MaxWidth="560">
                <FontIcon
                    Glyph="&#xE721;"
                    FontSize="32"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="{x:Bind s:Strings.SearchEmptyHeading}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2" />
                <StackPanel x:Name="ExamplesPanel" Spacing="6" />
            </StackPanel>
        </Grid>

        <!-- The question box: always at the bottom. Enter sends. -->
        <Grid Grid.Row="2" Padding="24,8,24,20" ColumnSpacing="8" MaxWidth="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Input"
                MaxLength="500"
                AcceptsReturn="False"
                TextWrapping="NoWrap"
                PlaceholderText="{x:Bind s:Strings.SearchInputPlaceholder}"
                KeyDown="OnInputKeyDown"
                TextChanged="OnInputChanged"
                AutomationProperties.Name="{x:Bind s:Strings.SearchInputPlaceholder}" />
            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSendClick"
                IsEnabled="False"
                ToolTipService.ToolTip="{x:Bind s:Strings.SearchSend}"
                AutomationProperties.Name="{x:Bind s:Strings.SearchSend}">
                <FontIcon Glyph="&#xE724;" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Page>
