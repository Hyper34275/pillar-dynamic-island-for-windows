<Page
    x:Class="CompanyIsland.Center.Pages.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:CompanyIsland.Center.Services"
    xmlns:s="using:CompanyIsland.Center.Core"
    Background="Transparent">

    <Page.Resources>
        <!-- Quiet icon buttons for the card actions. -->
        <Style x:Key="CardIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="CenterFlyoutStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CenterStrongBorderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="IsDefaultShadowEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="Body" Padding="24" Spacing="16" MaxWidth="1000">

            <!-- Header: title on one side, search and view switch on the other. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind s:Strings.NotesTitle}"
                        Style="{StaticResource TitleTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock
                        Text="{x:Bind s:Strings.NotesSubtitle}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="240"
                        QueryIcon="Find"
                        PlaceholderText="{x:Bind s:Strings.NotesSearchPlaceholder}"
                        TextChanged="OnSearchTextChanged"
                        AutomationProperties.Name="{x:Bind s:Strings.NotesSearchName}" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            x:Name="ListToggle"
                            IsChecked="True"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="OnListToggleClick"
                            ToolTipService.ToolTip="{x:Bind s:Strings.ListViewName}"
                            AutomationProperties.Name="{x:Bind s:Strings.ListViewName}">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="GridToggle"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="OnGridToggleClick"
                            ToolTipService.ToolTip="{x:Bind s:Strings.GridViewName}"
                            AutomationProperties.Name="{x:Bind s:Strings.GridViewName}">
                            <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />

            <ContentControl x:Name="Interactive" HorizontalContentAlignment="Stretch" IsTabStop="False">
            <StackPanel Spacing="16">
            <!-- New note -->
            <Border
                x:Name="EditorCard"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBox
                        x:Name="Editor"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="92"
                        MaxHeight="240"
                        MaxLength="10000"
                        TextAlignment="DetectFromContent"
                        PlaceholderText="{x:Bind s:Strings.NewNotePlaceholder}"
                        TextChanged="OnEditorTextChanged"
                        PreviewKeyDown="OnEditorKeyDown"
                        AutomationProperties.Name="{x:Bind s:Strings.NewNoteName}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="EditorMessage"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Ctrl+Enter" />
                        <TextBlock
                            x:Name="EditorCounter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="SaveButton"
                            Grid.Column="2"
                            MinWidth="88"
                            Content="{x:Bind s:Strings.SaveNote}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False"
                            Click="OnSaveClick"
                            ToolTipService.ToolTip="{x:Bind s:Strings.SaveNoteHint}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Empty states -->
            <StackPanel x:Name="EmptyState" Spacing="8" Padding="0,32" HorizontalAlignment="Center" Visibility="Collapsed">
                <FontIcon x:Name="EmptyIcon" Glyph="&#xE70B;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock
                    x:Name="EmptyBody"
                    MaxWidth="420"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Notes: pinned first, then newest. -->
            <ItemsRepeater x:Name="NotesRepeater" ItemsSource="{x:Bind Items}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="services:NoteViewModel">
                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{x:Bind CardBorder, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Reading -->
                                <TextBlock
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    Visibility="{x:Bind IsViewing, Mode=OneWay}"
                                    MaxLines="{x:Bind MaxLines, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    TextAlignment="DetectFromContent"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Tag="{x:Bind}"
                                    DoubleTapped="OnNoteDoubleTapped" />

                                <!-- Editing in place -->
                                <TextBox
                                    Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{x:Bind IsEditing, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="96"
                                    MaxHeight="260"
                                    MaxLength="10000"
                                    TextAlignment="DetectFromContent"
                                    PreviewKeyDown="OnCardEditorKeyDown"
                                    AutomationProperties.Name="{x:Bind s:Strings.EditNote}" />

                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="&#xE718;"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind Pinned, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind s:Strings.PinnedBadge}" />
                                        <TextBlock
                                            Text="{x:Bind TimeText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Reading: pin, copy, edit, delete -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Visibility="{x:Bind IsViewing, Mode=OneWay}">
                                        <Button
                                            Style="{StaticResource CardIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            Click="OnPinClick"
                                            ToolTipService.ToolTip="{x:Bind PinTip, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind PinTip, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind PinGlyph, Mode=OneWay}" FontSize="15" />
                                        </Button>
                                        <Button
                                            Style="{StaticResource CardIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            Click="OnCopyClick"
                                            ToolTipService.ToolTip="{x:Bind CopyTip, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind CopyTip, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind CopyGlyph, Mode=OneWay}" FontSize="15" />
                                        </Button>
                                        <Button
                                            Style="{StaticResource CardIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            Click="OnEditClick"
                                            ToolTipService.ToolTip="{x:Bind s:Strings.EditNote}"
                                            AutomationProperties.Name="{x:Bind s:Strings.EditNote}">
                                            <FontIcon Glyph="&#xE70F;" FontSize="15" />
                                        </Button>
                                        <Button
                                            Style="{StaticResource CardIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            Click="OnDeleteClick"
                                            ToolTipService.ToolTip="{x:Bind s:Strings.DeleteNote}"
                                            AutomationProperties.Name="{x:Bind s:Strings.DeleteNote}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Editing: save / cancel -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsEditing, Mode=OneWay}">
                                        <Button
                                            Content="{x:Bind s:Strings.SaveNote}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="80"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanSaveEdit, Mode=OneWay}"
                                            Click="OnSaveEditClick"
                                            ToolTipService.ToolTip="{x:Bind s:Strings.SaveNoteHint}" />
                                        <Button
                                            Content="{x:Bind s:Strings.Cancel}"
                                            MinWidth="80"
                                            Tag="{x:Bind}"
                                            Click="OnCancelEditClick"
                                            ToolTipService.ToolTip="{x:Bind s:Strings.CancelHint}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
