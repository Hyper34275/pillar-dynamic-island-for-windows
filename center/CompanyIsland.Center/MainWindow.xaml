<Window
    x:Class="CompanyIsland.Center.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:CompanyIsland.Center.Core">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" FlowDirection="RightToLeft">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <!-- Info bars: a neutral dark card (the severity stays visible in the icon). Local, because the control ignores app-level overrides. -->
                        <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FF140E0E" />
                        <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FF14120A" />
                        <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FF0B0B0B" />
                        <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FF0B0B0B" />
                    </ResourceDictionary>
                    <!-- High contrast: the user's own window colour, so the text colour the system picks stays readable. -->
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="1">
            <!-- Island not reachable: the Center keeps trying every few seconds while it is open. -->
            <InfoBar
                x:Name="DisconnectedBar"
                Severity="Warning"
                IsOpen="False"
                IsClosable="False"
                CornerRadius="0"
                Title="{x:Bind s:Strings.DisconnectedTitle}"
                Message="{x:Bind s:Strings.DisconnectedMessage}">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="StartIslandButton"
                        Content="{x:Bind s:Strings.StartIsland}"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnStartIslandClick"
                        AutomationProperties.Name="{x:Bind s:Strings.StartIsland}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="NoticeBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True"
                CornerRadius="0" />
        </StackPanel>

        <!-- Icons only; the pane opens over the page while the pointer (or keyboard focus) is on it. See MainWindow.HookPaneHover. -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            CompactPaneLength="48"
            OpenPaneLength="232"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            Loaded="OnNavLoaded"
            PaneOpening="OnPaneOpening"
            PaneClosing="OnPaneClosing"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <!-- Selected item = white with black text (set here because the item template ignores the app-level overrides). -->
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#F2FFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF000000" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF000000" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF000000" />
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF000000" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavWelcome" Tag="welcome" Content="{x:Bind s:Strings.NavWelcome}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavNotes" Tag="notes" Content="{x:Bind s:Strings.NavNotes}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSearch" Tag="search" Content="{x:Bind s:Strings.NavSearch}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Tag="settings" Content="{x:Bind s:Strings.NavSettings}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavTour" Tag="tour" Content="{x:Bind s:Strings.NavTour}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <TextBlock
                    x:Name="VersionText"
                    Visibility="Collapsed"
                    Margin="16,8,16,16"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </NavigationView.PaneFooter>

            <Grid x:Name="PageHost" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        </NavigationView>
    </Grid>
</Window>
